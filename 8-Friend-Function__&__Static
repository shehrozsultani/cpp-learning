// Post-Lab: VicobaAccount — Static Interest Rate
// ============================================================
/*
 * KEY CONCEPT — static Data Member:
 *   A static member is SHARED across all objects of the class.
 *   Only ONE copy exists, no matter how many objects are created.
 *   Declared with 'static' inside the class, defined OUTSIDE.
 *
 * KEY CONCEPT — static Member Function:
 *   Can be called without creating an object: ClassName::function()
 *   Can only access static data members.
 */

class VicobaAccount {
private:
    double amountBorrowed;    // Loan amount
    int    loanDuration;      // Duration in years
    static double annualInterestRate;  // Shared across all accounts

public:
    // Constructor: takes loan amount and duration
    VicobaAccount(double amount, int years)
        : amountBorrowed(amount), loanDuration(years) {}

    // Static function to change the interest rate for ALL accounts
    static void setInterestRate(double rate) {
        annualInterestRate = rate;
        cout << "Interest rate updated to: " << annualInterestRate << "%" << endl;
    }

    // Calculate total repayment using simple interest
    // Formula: Total = Principal + (Principal × Rate × Time) / 100
    double calculateRepayment() {
        double interest = (amountBorrowed * annualInterestRate * loanDuration) / 100.0;
        return amountBorrowed + interest;
    }

    // Getters and setters
    double getAmount()   const { return amountBorrowed;   }
    int    getDuration() const { return loanDuration;     }
    void   setAmount(double a) { amountBorrowed = a;      }
    void   setDuration(int d)  { loanDuration   = d;      }

    void display() {
        cout << "Loan Amount:    " << amountBorrowed    << " TZS" << endl;
        cout << "Duration:       " << loanDuration      << " years" << endl;
        cout << "Interest Rate:  " << annualInterestRate << "%" << endl;
        cout << "Total Repay:    " << calculateRepayment() << " TZS" << endl;
    }
};

// Define static member OUTSIDE the class
double VicobaAccount::annualInterestRate = 10.0;

void postlab_vicobaAccount() {
    cout << "\n===== Post-Lab: VicobaAccount =====" << endl;

    VicobaAccount acc1(500000, 2);
    VicobaAccount acc2(300000, 3);

    cout << "\n--- Account 1 ---" << endl; acc1.display();
    cout << "\n--- Account 2 ---" << endl; acc2.display();

    // Change rate for ALL accounts using static function
    VicobaAccount::setInterestRate(15.0);

    cout << "\n--- After rate change ---" << endl;
    cout << "\n--- Account 1 ---" << endl; acc1.display();
    cout << "\n--- Account 2 ---" << endl; acc2.display();
}


