/*
 * File Handling Assignments
 * =====================================================
 * Assignment Programs (from slide notes):
 *
 *  Prog 1:  Maintain Book Records
 *  Prog 2:  Read and Write File Operations
 *  Prog 3:  Append Data without Affecting Previous Data
 *  Prog 4:  Merge Two Files into a Third File
 *  Prog 5:  Count Digits, Alphabets & Spaces
 *  Prog 6:  Count Occurrence of a Word
 *  Prog 7:  Read/Write Student Details
 *
 * Remember:
 *   ios::app  → Append mode (adds to end, doesn't overwrite)
 *   ios::in   → Read mode
 *   ios::out  → Write mode (default for ofstream)
 *   ios::trunc → Truncate (clears file on open — default if not using append)
 */

#include <iostream>
#include <fstream>
#include <string>
using namespace std;


// ============================================================
// Prog 1: Maintain Book Records
// ============================================================

struct Book {
    char title[50];
    char author[30];
    int  year;
    float price;
};

void prog1_bookRecords() {
    cout << "\n===== Prog 1: Book Records =====" << endl;

    // Write 2 book records
    ofstream out("books.txt");
    Book b1 = {"C++ How to Program", "Deitel & Deitel", 2020, 45.99f};
    Book b2 = {"Object-Oriented Analysis", "Grady Booch", 2018, 38.50f};

    out << b1.title << "\n" << b1.author << "\n" << b1.year << "\n" << b1.price << "\n";
    out << b2.title << "\n" << b2.author << "\n" << b2.year << "\n" << b2.price << "\n";
    out.close();

    // Read and display records
    cout << "Book Records from file:" << endl;
    string line;
    ifstream in("books.txt");
    int count = 1;
    while (getline(in, line)) {
        cout << "  [" << count++ << "] " << line << endl;
    }
    in.close();
}


// ============================================================
// Prog 2: Read and Write File Operations
// ============================================================

void prog2_readWrite() {
    cout << "\n===== Prog 2: Read & Write File Operations =====" << endl;

    // Write
    ofstream out("rw_test.txt");
    out << "Pakistan\nZindabad\nOOP is great!\n";
    out.close();
    cout << "Data written to 'rw_test.txt'" << endl;

    // Read
    cout << "Data read from 'rw_test.txt':" << endl;
    string line;
    ifstream in("rw_test.txt");
    while (getline(in, line))
        cout << "  " << line << endl;
    in.close();
}


// ============================================================
// Prog 3: Append Data Without Affecting Previous Data
// ============================================================
/*
 * KEY: ios::app → opens file and keeps existing content.
 *   All new writes go to the END of file.
 *   Without ios::app, ofstream ERASES the file on open!
 */

void prog3_appendData() {
    cout << "\n===== Prog 3: Append to File =====" << endl;

    // First write
    ofstream out("append_test.txt");
    out << "First entry: OOP Lab\n";
    out.close();

    // Append without erasing
    ofstream app("append_test.txt", ios::app);   // ios::app = append mode
    app << "Second entry: File Handling\n";
    app << "Third entry: Appended!\n";
    app.close();

    // Display all content
    cout << "File contents after append:" << endl;
    string line;
    ifstream in("append_test.txt");
    while (getline(in, line))
        cout << "  " << line << endl;
    in.close();
}


// ============================================================
// Prog 4: Merge Two Files into a Third File
// ============================================================

void prog4_mergeFiles() {
    cout << "\n===== Prog 4: Merge Two Files =====" << endl;

    // Create file1
    ofstream f1("merge_file1.txt");
    f1 << "File 1 Line 1\nFile 1 Line 2\n";
    f1.close();

    // Create file2
    ofstream f2("merge_file2.txt");
    f2 << "File 2 Line A\nFile 2 Line B\n";
    f2.close();

    // Merge both into file3
    ofstream f3("merged_output.txt");
    ifstream in1("merge_file1.txt");
    ifstream in2("merge_file2.txt");

    string line;
    while (getline(in1, line)) f3 << line << "\n";
    while (getline(in2, line)) f3 << line << "\n";

    in1.close(); in2.close(); f3.close();

    // Display merged result
    cout << "Merged file content:" << endl;
    ifstream result("merged_output.txt");
    while (getline(result, line))
        cout << "  " << line << endl;
    result.close();
}


// ============================================================
// Prog 5: Count Digits, Alphabets & Spaces
// ============================================================

void prog5_countDigitsAlphasSpaces() {
    cout << "\n===== Prog 5: Count Digits, Alphabets & Spaces =====" << endl;

    // Create test file
    ofstream writer("data_analysis.txt");
    writer << "C++ was created in 1983 by Bjarne Stroustrup at Bell Labs.";
    writer.close();

    int digits = 0, alphabets = 0, spaces = 0;
    char ch;

    ifstream in("data_analysis.txt");
    if (!in) { cout << "File error!" << endl; return; }

    in.get(ch);   // Priming read
    while (!in.eof()) {
        if (ch >= '0' && ch <= '9')                          digits++;
        else if ((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')) alphabets++;
        else if (ch == ' ')                                   spaces++;
        in.get(ch);
    }
    in.close();

    cout << "Digits:    " << digits    << endl;
    cout << "Alphabets: " << alphabets << endl;
    cout << "Spaces:    " << spaces    << endl;
}


// ============================================================
// Prog 6: Count Occurrence of a Word
// ============================================================

void prog6_countWordOccurrence() {
    cout << "\n===== Prog 6: Count Word Occurrence =====" << endl;

    // Create test file
    ofstream writer("word_test.txt");
    writer << "the cat sat on the mat the cat is on the mat";
    writer.close();

    string targetWord = "the";
    string word;
    int    count = 0;

    ifstream in("word_test.txt");
    if (!in) { cout << "File error!" << endl; return; }

    while (in >> word) {
        if (word == targetWord) count++;
    }
    in.close();

    cout << "Word '" << targetWord << "' appears " << count << " time(s)." << endl;
}


// ============================================================
// Prog 7: Read/Write Student Details
// ============================================================

void prog7_studentDetails() {
    cout << "\n===== Prog 7: Student Details in File =====" << endl;

    // Write 3 student records
    ofstream out("student_details.txt");
    out << "101 Ali_Ahmed    20 88.5\n";
    out << "102 Sara_Khan    19 92.0\n";
    out << "103 Umar_Farooq  21 75.5\n";
    out.close();
    cout << "Student details written." << endl;

    // Read and display
    cout << "\nStudent Details:" << endl;
    cout << "Roll  Name          Age  Marks" << endl;
    cout << "----  ----          ---  -----" << endl;

    int   roll, age;
    float marks;
    string name;
    ifstream in("student_details.txt");

    while (in >> roll >> name >> age >> marks) {
        cout << roll  << "   "
             << name  << "\t"
             << age   << "   "
             << marks << endl;
    }
    in.close();
}


// ============================================================
// MAIN  Run all assignment programs
// ============================================================

int main() {
    prog1_bookRecords();
    prog2_readWrite();
    prog3_appendData();
    prog4_mergeFiles();
    prog5_countDigitsAlphasSpaces();
    prog6_countWordOccurrence();
    prog7_studentDetails();

    cout << "\n===== All Assignment Programs Completed! =====" << endl;
    return 0;
}
