/*
 * Student Average Marks — Array of Objects
 * -------------------------------------------------------
 * Concept: Array of Objects
 * - Creates 5 Student objects stored in an array.
 * - Each student has a roll number and marks in 3 subjects.
 * - Program calculates and displays the average marks for each student.
 */

#include <iostream>
using namespace std;

class Student {
private:
    int rollNo;      // Stores student roll number
    int marks[3];    // Stores marks for 3 subjects

public:
    // Takes input for roll number and marks
    void inputData() {
        cout << "Enter Roll Number: ";
        cin >> rollNo;
        cout << "Enter marks in 3 subjects: ";
        for (int i = 0; i < 3; i++) {
            cin >> marks[i];
        }
    }

    // Calculates and displays average marks
    void displayData() {
        int sum = 0;
        for (int i = 0; i < 3; i++) {
            sum += marks[i];
        }
        float average = sum / 3.0f;  // Calculate average
        cout << "Roll No: " << rollNo
             << " | Average Marks: " << average << endl;
    }
};

int main() {
    Student students[5];  // Array of 5 Student objects

    // Input data for all 5 students
    for (int i = 0; i < 5; i++) {
        cout << "\n--- Student " << i + 1 << " ---" << endl;
        students[i].inputData();
    }

    cout << "\n--- Results ---" << endl;

    // Display results for all 5 students
    for (int i = 0; i < 5; i++) {
        students[i].displayData();
    }

    return 0;
}
