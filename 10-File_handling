// MAIN — Run all programs
// ============================================================

int main() {
    prog1_writeIntegers();
    prog2_readIntegers();
    prog3_writeString();
    prog4_readString();
    prog5_countVowels();
    prog6_createAndRead();
    prog7_copyFile();
    prog8_countWordsLinesSize();
    prog9_studentRecords();

    cout << "\n===== All File Handling Programs Completed! =====" << endl;
    return 0;
}
