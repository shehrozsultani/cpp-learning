// ========================================================
// Task 002: Find the Middle Number
// ========================================================
// Given 3 numbers, find which one is the middle value.

void task002() {
    int a, b, c;
    cout << "Enter 3 numbers: ";
    cin >> a >> b >> c;

    // Check which number lies between the other two
    if      ((a < b && a > c) || (a > b && a < c)) cout << "Middle: " << a << endl;
    else if ((b > a && b < c) || (b < a && b > c)) cout << "Middle: " << b << endl;
    else                                            cout << "Middle: " << c << endl;
}


// ========================================================
// Task 003: Word, Space, Character Count
// ========================================================

void task003() {
    string str;
    int words = 1, spaces = 0, charc = 0;

    cout << "Enter a string: ";
    getline(cin, str);

    for (int i = 0; i < (int)str.length(); i++) {
        if (str[i] == ' ') {
            spaces++;
            words++;  // Each space starts a new word
        }
        charc++;
    }

    cout << "Words:      " << words           << endl;
    cout << "Spaces:     " << spaces          << endl;
    cout << "Characters: " << charc - spaces  << endl;  // Exclude spaces
}


// ========================================================
// Task 004: Palindrome Check
// ========================================================
// A palindrome reads the same forwards and backwards. e.g., "racecar"

void task004() {
    string a;
    cout << "Enter a string: ";
    cin >> a;

    int start   = 0;
    int end     = a.length() - 1;
    bool isPalin = true;

    while (start < end) {
        if (a[start] != a[end]) {
            isPalin = false;
            break;
        }
        start++;
        end--;
    }

    cout << (isPalin ? "Palindrome!" : "Not a palindrome.") << endl;
}


