/*
 * ORIGINAL BUGGY CODE (do NOT compile this):
 *
 * #include <iostream>
 * class Student {
 * public:
 *     string name;              // Error 1: 'string' not recognized — missing #include<string> and 'using namespace std'
 *     string rollNo;
 *     string subjects[5];
 * }                              // Error 2: Missing semicolon (;) after class definition
 * main()                         // Error 3: main() must return int → int main()
 * {
 *     Student std1, std2;
 *     Student.name = "Name";     // Error 4: Cannot use class name — use object name: std1.name
 *     std2.name = std1.name;
 *     std2.rollNo = std1.rollNo;
 *     std2.subjects = std1.subjects; // Error 5: Arrays cannot be assigned with =, use a loop
 *     cout << std2 << endl;          // Error 6: cout does not know how to print a whole object
 * }
 */

//  CORRECTED VERSION:
class Student {
public:
    string name;
    string rollNo;
    string subjects[5];

    void copyFrom(const Student& src) {
        name   = src.name;
        rollNo = src.rollNo;
        for (int i = 0; i < 5; i++) {
            subjects[i] = src.subjects[i];   //  Correct way to copy an array
        }
    }

    void display() {
        cout << "Name:   " << name   << endl;
        cout << "RollNo: " << rollNo << endl;
    }
};


