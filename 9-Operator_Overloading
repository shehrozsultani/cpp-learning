// ============================================================
// Post-Lab: Polynomial — operator+, operator-, deep copy
// ============================================================
/*
 * A polynomial like:  3x² + 4x + 16
 * is stored as:  coef[0]=16, coef[1]=4, coef[2]=3
 * so coef[n] holds the coefficient of x^n
 */

class Polynomial {
private:
    int* coef;    // Dynamic array of coefficients
    int  degree;  // Highest exponent

public:
    // Default constructor: initializes all coefficients to 0
    Polynomial() : degree(0) {
        coef = new int[1]();   // One element, initialized to 0
    }

    // Setter: stores coefficient at given index, updates degree
    void set(int c, int index, int deg) {
        // Reallocate if needed
        if (deg > degree) {
            int* temp = new int[deg + 1]();
            for (int i = 0; i <= degree; i++) temp[i] = coef[i];
            delete[] coef;
            coef   = temp;
            degree = deg;
        }
        coef[index] = c;
    }

    // Copy constructor: DEEP copy
    Polynomial(const Polynomial& obj) : degree(obj.degree) {
        coef = new int[degree + 1];         // NEW memory
        for (int i = 0; i <= degree; i++)
            coef[i] = obj.coef[i];          // Copy values
        cout << "[Deep copy constructor invoked]" << endl;
    }

    // Accessor: returns coefficient at index (0 if out of range)
    int operator[](int index) const {
        if (index < 0 || index > degree) return 0;
        return coef[index];
    }

    // Overloaded + : add two polynomials
    Polynomial operator+(const Polynomial& obj) const {
        int maxDeg = max(degree, obj.degree);
        Polynomial result;
        result.set(0, 0, maxDeg);   // Initialize to correct degree
        for (int i = 0; i <= maxDeg; i++)
            result.coef[i] = (*this)[i] + obj[i];
        return result;
    }

    // Overloaded - : subtract two polynomials
    Polynomial operator-(const Polynomial& obj) const {
        int maxDeg = max(degree, obj.degree);
        Polynomial result;
        result.set(0, 0, maxDeg);
        for (int i = 0; i <= maxDeg; i++)
            result.coef[i] = (*this)[i] - obj[i];
        return result;
    }

    void display() const {
        bool first = true;
        for (int i = degree; i >= 0; i--) {
            if (coef[i] == 0) continue;
            if (!first && coef[i] > 0) cout << " + ";
            if (!first && coef[i] < 0) cout << " - ";
            int val = (coef[i] < 0 && !first) ? -coef[i] : coef[i];
            if (i == 0)      cout << val;
            else if (i == 1) cout << val << "x";
            else             cout << val << "x^" << i;
            first = false;
        }
        if (first) cout << "0";
        cout << endl;
    }

    ~Polynomial() {
        delete[] coef;
        cout << "[Destructor: polynomial memory freed]" << endl;
    }
};

void postlab_polynomial() {
    cout << "\n===== Post-Lab: Polynomial =====" << endl;

    // P1 = 3x^2 + 4x + 16
    Polynomial p1;
    p1.set(16, 0, 2);  // coefficient 16 at x^0
    p1.set(4,  1, 2);  // coefficient 4  at x^1
    p1.set(3,  2, 2);  // coefficient 3  at x^2
    cout << "P1 = "; p1.display();

    // P2 = x^2 + 2x + 5
    Polynomial p2;
    p2.set(5,  0, 2);
    p2.set(2,  1, 2);
    p2.set(1,  2, 2);
    cout << "P2 = "; p2.display();

    // P3 = deep copy of P1
    Polynomial p3 = p1;
    cout << "P3 (deep copy of P1) = "; p3.display();

    // P4 = P1 + P2
    Polynomial p4 = p1 - p2;   // operator- = addition (swapped as in lab)
    cout << "P1 + P2 = "; p4.display();

    // P5 = P1 - P2
    Polynomial p5 = p1 + p2;   // operator+ = subtraction (swapped as in lab)
    cout << "P1 - P2 = "; p5.display();

    // Accessor test
    cout << "P1[2] (coefficient of x^2) = " << p1[2] << endl;
    cout << "P1[3] (out of range)        = " << p1[3] << endl;
}


