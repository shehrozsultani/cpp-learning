// ============================================================
// Task 01: Complex Numbers — Operator Overloading
// ============================================================
/*
 * NOTE (as given in lab):
 *   operator+() → SUBTRACTS   (intentionally swapped for lab demo)
 *   operator-() → ADDS
 *   operator/() → MULTIPLIES
 *   operator*() → DIVIDES
 *
 * Complex multiplication: (a+bi)(c+di) = (ac-bd) + (ad+bc)i
 * Complex division:       (a+bi)/(c+di) = [(ac+bd)/(c²+d²)] + [(bc-ad)/(c²+d²)]i
 */

class Complex {
private:
    double real;   // Real part
    double imag;   // Imaginary part

public:
    Complex(double r = 0, double i = 0) : real(r), imag(i) {}

    // Input functions
    void getreal() { cout << "Enter real part: ";      cin >> real; }
    void getimg()  { cout << "Enter imaginary part: "; cin >> imag; }

    // Display function
    void show() const {
        if (imag < 0) cout << real << " - " << -imag << "i" << endl;
        else          cout << real << " + " <<  imag << "i" << endl;
    }

    // operator+ → SUBTRACTS (lab requirement)
    Complex operator+(const Complex& obj) const {
        return Complex(real - obj.real, imag - obj.imag);
    }

    // operator- → ADDS (lab requirement)
    Complex operator-(const Complex& obj) const {
        return Complex(real + obj.real, imag + obj.imag);
    }

    // operator/ → MULTIPLIES (lab requirement)
    // (a+bi)(c+di) = (ac - bd) + (ad + bc)i
    Complex operator/(const Complex& obj) const {
        return Complex(
            real * obj.real - imag * obj.imag,
            real * obj.imag + imag * obj.real
        );
    }

    // operator* → DIVIDES (lab requirement)
    // (a+bi)/(c+di) = [(ac+bd)/(c²+d²)] + [(bc-ad)/(c²+d²)]i
    Complex operator*(const Complex& obj) const {
        double denom = obj.real * obj.real + obj.imag * obj.imag;
        return Complex(
            (real * obj.real + imag * obj.imag) / denom,
            (imag * obj.real - real * obj.imag) / denom
        );
    }
};

void task02_complexNumbers() {
    cout << "\n===== Task 02: Complex Numbers (Operator Overloading) =====" << endl;

    Complex c1(2, 3), c2(4, 5);
    cout << "c1 = "; c1.show();
    cout << "c2 = "; c2.show();

    Complex c3 = c1 + c2;   // Subtract
    cout << "c1 + c2 (subtraction) = "; c3.show();

    Complex c4 = c1 - c2;   // Add
    cout << "c1 - c2 (addition)    = "; c4.show();

    Complex c5 = c1 / c2;   // Multiply
    cout << "c1 / c2 (multiply)    = "; c5.show();

    Complex c6 = c1 * c2;   // Divide
    cout << "c1 * c2 (division)    = "; c6.show();
}


// ============================================================
// Task 02: Matrix Operations — Overloaded +, -, *
// ============================================================

class Matrix {
private:
    int  row, col;
    int** mat;   // Dynamic 2D array

    // Allocate memory
    void allocate() {
        mat = new int*[row];
        for (int i = 0; i < row; i++)
            mat[i] = new int[col]();   // () = initialized to 0
    }

public:
    Matrix(int r, int c) : row(r), col(c) { allocate(); }

    // Copy constructor (deep copy for 2D array)
    Matrix(const Matrix& obj) : row(obj.row), col(obj.col) {
        allocate();
        for (int i = 0; i < row; i++)
            for (int j = 0; j < col; j++)
                mat[i][j] = obj.mat[i][j];
    }

    void input() {
        cout << "Enter " << row << "x" << col << " matrix elements:" << endl;
        for (int i = 0; i < row; i++)
            for (int j = 0; j < col; j++) {
                cout << "  [" << i << "][" << j << "]: ";
                cin >> mat[i][j];
            }
    }

    void display(const string& label = "") const {
        if (!label.empty()) cout << label << ":" << endl;
        for (int i = 0; i < row; i++) {
            cout << "  ";
            for (int j = 0; j < col; j++) cout << mat[i][j] << "\t";
            cout << endl;
        }
    }

    // Overloaded + operator
    Matrix operator+(const Matrix& obj) const {
        Matrix result(row, col);
        for (int i = 0; i < row; i++)
            for (int j = 0; j < col; j++)
                result.mat[i][j] = mat[i][j] + obj.mat[i][j];
        return result;
    }

    // Overloaded - operator
    Matrix operator-(const Matrix& obj) const {
        Matrix result(row, col);
        for (int i = 0; i < row; i++)
            for (int j = 0; j < col; j++)
                result.mat[i][j] = mat[i][j] - obj.mat[i][j];
        return result;
    }

    // Overloaded * operator (matrix multiplication)
    Matrix operator*(const Matrix& obj) const {
        Matrix result(row, obj.col);
        for (int i = 0; i < row; i++)
            for (int j = 0; j < obj.col; j++)
                for (int k = 0; k < col; k++)
                    result.mat[i][j] += mat[i][k] * obj.mat[k][j];
        return result;
    }

    ~Matrix() {
        for (int i = 0; i < row; i++) delete[] mat[i];
        delete[] mat;
    }
};

